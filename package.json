{
  "name": "taskspace-vue-lab-10",
  "version": "1.0.0",
  "private": true,
  "description": "TaskSpace с разделённой архитектурой и расширенными задачами — лабораторная работа №10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "author": "Чистюхин Антон",
  "license": "ISC",
  "dependencies": {
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
